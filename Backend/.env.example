# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Exact origin of the deployed/dev frontend (no trailing slash, no wildcard)
ALLOWED_ORIGIN=http://localhost:5173

# Any long random string, used only to salt the hashed IP used for rate limiting.
# Generate one with: openssl rand -hex 32
IP_HASH_SALT=
